# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment variables
*.env*
!.env.example

# Temp files
.tmp/

# Runtime data (sqlite dbs, broker state)
data/

# Streamlit secrets (materialized from env vars by the monitor)
.streamlit/secrets.toml

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup

# Ansible generated files
ansible/inventory.ini
ansible/*.retry

# MacOS
.DS_Store
terraform/terraform.tfvars
