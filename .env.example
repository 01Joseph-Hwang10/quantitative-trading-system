# Quantitative Trading System — environment templates.
# - `.env`       → local use (BROKER=mock; never places real orders)
# - `.env.production` → synced to the VM by Ansible (BROKER=toss — REAL orders)
# Both are gitignored; never commit real values.

# Broker ("mock" | "toss")
# ⚠️ BROKER=toss means the trader daemon places REAL orders at the decision
# schedule (default 15:00 KST on KRX trading days). Use "mock" for testing.
BROKER=toss
TOSSSEC_CLIENT_ID=
TOSSSEC_CLIENT_SECRET=

# Monitor (Streamlit native Google OIDC; redirect URI must match the Google
# OAuth client's authorized redirect URI. With the production SSH port-forward
# (`ssh -L 8501:localhost:8501`), the browser sees localhost, so keep the
# default below — do NOT point it at the VM's static IP (Google rejects bare-IP
# redirect URIs).
AUTHORIZED_USERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501/oauth2callback

# Runtime
DATA_DIR=./data
TRADER_ENABLED=true
DECISION_SCHEDULE_CRON=0 15 * * 1-5
FEED_UPDATE_SCHEDULE_CRON=0 9 * * 1-5
LOG_LEVEL=INFO
