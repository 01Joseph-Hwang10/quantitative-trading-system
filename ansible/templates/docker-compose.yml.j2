services:
  trader:
    image: {{ image_base }}:{{ tag }}
    command: python -m system.apps.trader
    env_file: .env
    environment:
      - DATA_DIR=/app/data
      # Presence of this variable enables shipping logs to GCP Logging from
      # inside the container (metadata-server ADC + roles/logging.logWriter).
      - GOOGLE_CLOUD_PROJECT={{ gcp_project }}
    volumes:
      - ./data:/app/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-m", "system.apps.trader", "healthcheck"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s

  monitor:
    image: {{ image_base }}:{{ tag }}
    command: python -m system.apps.monitor
    env_file: .env
    environment:
      - DATA_DIR=/app/data
      - GOOGLE_CLOUD_PROJECT={{ gcp_project }}
    volumes:
      - ./data:/app/data
    ports:
      # Published on all interfaces: reached via the Cloud Run proxy (spec 010)
      # AND via SSH port-forwarding (loopback path unchanged).
      - "8501:8501"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stalive/health')"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 60s
